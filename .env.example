# HTTP port for client (nginx)
HTTP_PORT=8080

# Postgres
PG_PASSWORD=change-me-strong-postgres-password

# JWT (long random string)
JWT_SECRET=change-me-to-very-long-random-string-at-least-32-chars

# Web Push (generate with: docker compose run --rm server npm run vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
